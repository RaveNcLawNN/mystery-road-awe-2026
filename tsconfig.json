{
  // Type-checking only: Vite strips the types and bundles, tsc never emits files.
  "compilerOptions": {
    // --- language & environment ---
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // vite/client: types for importing non-code files, e.g. an .svg import is a URL string
    "types": ["vite/client"],

    // --- modules: resolved the way Vite resolves them ---
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // every file must be transpilable on its own (Vite compiles file by file)
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // JSX in .tsx files: type-checked here, compiled by @vitejs/plugin-react
    // to calls of react/jsx-runtime (no `import React` needed)
    "jsx": "react-jsx",

    // --- strictness ---
    // strict: noImplicitAny, strictNullChecks, strictFunctionTypes,
    // strictBindCallApply, strictPropertyInitialization, noImplicitThis,
    // useUnknownInCatchVariables, alwaysStrict, strictBuiltinIteratorReturn
    "strict": true,
    // array[i] and record[key] may be undefined: they are typed as T | undefined
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "skipLibCheck": true
  },
  "include": ["src"]
}
